          "previous": null,
          "dirty": true
        }
      },
      "section-label": {
        "en": "The Case for Inspection",
        "es": {
          "current": "El caso de la inspección",
          "previous": null,
          "dirty": true
        }
      },
      "headline": {
        "en": "Why automate quality inspection<br>for <span class=\"blue\">flat glass processing</span>",
        "es": {
          "current": "Por qué automatizar la inspección de calidad<br>para <span class=\"blue\">procesamiento de vidrio plano</span>",
          "previous": null,
          "dirty": true
        }
      },
      "subtitle": {
        "en": "Manual inspection versus automated inspection — the difference at a glance",
        "es": {
          "current": "Inspección manual versus inspección automatizada — la diferencia de un vistazo.",
          "previous": null,
          "dirty": true
        }
      },
      "col-header-prob": {
        "en": "Without Inspection Automation",
        "es": {
          "current": "Sin automatización de inspección",
          "previous": null,
          "dirty": true
        }
      },
      "prob-list": {
        "en": "<div class=\"compare-tier\" data-edit=\"tier-label-1\" spellcheck=\"false\">Human Limitations</div><li class=\"ls-list-hidden\">Operator fatigue — detection rates drop significantly over long shifts</li><li>As line speed increases, operator effectiveness declines — more throughput means more defects slip through</li><li>100% manual inspection is impossible at production speed</li><li>Distortion &amp; anisotropy are <strong>invisible to the naked eye</strong> — no matter how skilled the operator</li><div class=\"compare-tier\" data-edit=\"tier-label-2\" spellcheck=\"false\">Business Impact</div><li>Inconsistent quality &amp; frequent customer complaints</li><li>Construction-site rejections — glass already delivered &amp; installed means transport, rework &amp; project delays</li><li class=\"\">Increased liability risks &amp; reputational damage</li><li class=\"\">Automotive: one defect triggers a full batch return — shipping &amp; material costs on the entire load</li>",
        "es": {
          "current": "<div class=\"compare-tier\" data-edit=\"tier-label-1\" spellcheck=\"false\">Limitaciones humanas</div><li>Fatiga del operador — las tasas de detección disminuyen significativamente durante turnos largos</li><li>A medida que aumenta la velocidad de línea, la efectividad del operador disminuye — mayor rendimiento significa más defectos que se escapan</li><li>La inspección manual al 100% es imposible a velocidad de producción</li><li>La distorsión y anisotropía son <strong>invisibles a simple vista</strong> — sin importar cuán hábil sea el operador</li><div class=\"compare-tier\" data-edit=\"tier-label-2\" spellcheck=\"false\">Impacto empresarial</div><li>Calidad inconsistente y quejas frecuentes de clientes</li><li>Rechazos en obra — vidrio ya entregado e instalado significa transporte, retrabajo y retrasos en proyectos</li><li class=\"\">Mayor riesgo de responsabilidad y daño reputacional</li><li class=\"\">Automoción: un defecto desencadena la devolución de todo un lote — costos de envío y material en toda la carga</li>",
          "previous": null,
          "dirty": true
        }
      },
      "tier-label-1": {
        "en": "Human Limitations",
        "es": {
          "current": "Limitaciones humanas",
          "previous": null,
          "dirty": true
        }
      },
      "tier-label-2": {
        "en": "Business Impact",
        "es": {
          "current": "Impacto empresarial",
          "previous": null,
          "dirty": true
        }
      },
      "col-header-ben": {
        "en": "LineScanner &amp; Osprey",
        "es": {
          "current": "LineScanner y Osprey",
          "previous": null,
          "dirty": true
        }
      },
      "ben-list": {
        "en": "<li>100% inspection of every glass, every shift — no fatigue, no blind spots</li><li>Real-time process control &amp; quality feedback</li><li>Prove quality to customers — a documented defense against claims</li><li>Database &amp; archive for shift accountability and CpK analysis</li><li>Detects distortion, anisotropy &amp; surface defects <strong>invisible to the human eye</strong></li><li class=\"\">Acceptance procedures for new machinery (e.g. furnaces)</li><li draggable=\"false\" class=\"\">Mandatory as per industry standards</li><li class=\"\">Increase throughput &amp; reduce costly downstream rejects</li><li class=\"ls-list-hidden\">New item lo que sea&nbsp;</li>",
        "es": {
          "current": "<li>Inspección del 100% de cada vidrio, cada turno — sin fatiga, sin puntos ciegos</li><li>Control de proceso en tiempo real y retroalimentación de calidad</li><li>Demuestre calidad a los clientes — una defensa documentada contra reclamaciones</li><li>Base de datos y archivo para responsabilidad del turno y análisis de CpK</li><li>Detecta distorsión, anisotropía y defectos de superficie <strong>invisibles al ojo humano</strong></li><li class=\"\">Procedimientos de aceptación para maquinaria nueva (p. ej. hornos)</li><li draggable=\"false\" class=\"\">Obligatorio según los estándares de la industria</li><li class=\"\">Aumentar el rendimiento y reducir rechazos costosos aguas abajo</li><li class=\"\" contenteditable=\"true\">Nuevo elemento lo que sea&nbsp;</li>",
          "previous": null,
          "dirty": true
        }
      },
