        "en": "\n        <div class=\"ls-tab-list\">\n          <button class=\"ls-tab active\" data-panel=\"1\" data-edit=\"tab-about\" contenteditable=\"\" spellcheck=\"false\" style=\"\">About Us<button class=\"ls-tab-del\" data-builder-only=\"\" contenteditable=\"false\" title=\"Delete tab\">✕</button></button>\n          <button class=\"ls-tab\" data-panel=\"2\" data-edit=\"tab-technologies\" contenteditable=\"\" spellcheck=\"false\">Technologies<button class=\"ls-tab-del\" data-builder-only=\"\" contenteditable=\"false\" title=\"Delete tab\">✕</button></button>\n          <button class=\"ls-tab\" data-panel=\"3\" data-edit=\"tab-network\" contenteditable=\"\" spellcheck=\"false\">Global Network<button class=\"ls-tab-del\" data-builder-only=\"\" contenteditable=\"false\" title=\"Delete tab\">✕</button></button>\n          <button class=\"ls-tab\" data-panel=\"4\" data-edit=\"tab-iqc\" contenteditable=\"\" spellcheck=\"false\" style=\"\">IQC Group<button class=\"ls-tab-del\" data-builder-only=\"\" contenteditable=\"false\" title=\"Delete tab\">✕</button></button>\n        <button class=\"ls-tab-add\" data-builder-only=\"\">+ Tab</button></div>\n        <div class=\"ls-tab-panels\">\n\n          <!-- Panel 0 — team carousel (revealed by clicking the active tab) -->\n          <div class=\"ls-tab-panel\" data-panel=\"0\" style=\"padding-top:12px;\">\n            <div class=\"ls-carousel\" data-counter=\"\" data-edit=\"company-carousel\" data-track=\"template02-company:carousel\" style=\"flex:1;min-height:0;width:100%;\" contenteditable=\"\" spellcheck=\"false\">\n              <div class=\"ls-carousel-track\" style=\"transform:translateX(0px);\">\n                <div class=\"ls-carousel-slide\">\n                  <img src=\"/slides/uploads/Group-Picture-of-the-Team-members-.png\" alt=\"Group Picture of the Team members\" data-zoom=\"\">\n                  <div class=\"ls-carousel-caption\" data-edit=\"company-caption\" contenteditable=\"\" spellcheck=\"false\">Group Picture of the Team members</div>\n                </div>\n              </div>\n              \n            <div class=\"ls-carousel-counter\"></div></div>\n          </div>\n\n          <!-- Panel 1 — About: three pillar cards -->\n          <div class=\"ls-tab-panel active\" data-panel=\"1\">\n            <div class=\"template02-company-pillars\">\n              <div class=\"card card-pillar anim-in\" style=\"\">\n                <div class=\"card-pillar-num\">01</div>\n                <div class=\"card-pillar-content\">\n                  <div class=\"card-pillar-title\" data-edit=\"pillar-1-title\" contenteditable=\"\" spellcheck=\"false\">One Partner</div>\n                  <div class=\"card-pillar-desc\" data-edit=\"pillar-1-desc\" contenteditable=\"\" spellcheck=\"false\">for all your quality inspection needs — surface, geometry, dimension, and more</div>\n                </div>\n              </div>\n              <div class=\"card card-pillar anim-in\" style=\"\">\n                <div class=\"card-pillar-num\">02</div>\n                <div class=\"card-pillar-content\">\n                  <div class=\"card-pillar-title\" data-edit=\"pillar-2-title\" contenteditable=\"\" spellcheck=\"false\">Global Presence</div>\n                  <div class=\"card-pillar-desc\" data-edit=\"pillar-2-desc\" contenteditable=\"\" spellcheck=\"false\">global support hubs with local experts in 23 countries across 6 continents</div>\n                </div>\n              </div>\n              <div class=\"card card-pillar anim-in\" style=\"\">\n                <div class=\"card-pillar-num\">03</div>\n                <div class=\"card-pillar-content\">\n                  <div class=\"card-pillar-title\" data-edit=\"pillar-3-title\" contenteditable=\"\" spellcheck=\"false\">Technological Leadership</div>\n                  <div class=\"card-pillar-desc\" data-edit=\"pillar-3-desc\" contenteditable=\"\" spellcheck=\"false\">true scanning · bright-field · dark-field · reflection · spectrometer</div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Panel 2 — Technologies: feature list -->\n          <div class=\"ls-tab-panel\" data-panel=\"2\">\n            <div class=\"feature-list\" style=\"margin:12px 0 0;gap:8px;\">\n              <div class=\"feature-item anim-in\" style=\"\"><div class=\"feature-num\">1</div><div class=\"feature-text\"><strong data-edit=\"tech-1-name\" contenteditable=\"\" spellcheck=\"false\">90° Parallel-Light System</strong><span data-edit=\"tech-1-desc\" contenteditable=\"\" spellcheck=\"false\"> — Sensor-based technology using a 90° parallel-light beam to detect surface defects.</span></div></div>\n              <div class=\"feature-item anim-in\" style=\"\"><div class=\"feature-num\">2</div><div class=\"feature-text\"><strong data-edit=\"tech-2-name\" contenteditable=\"\" spellcheck=\"false\">Bright-field &amp; Dark-field</strong><span data-edit=\"tech-2-desc\" contenteditable=\"\" spellcheck=\"false\"> — Camera-based technology combining both illumination modes.</span></div></div>\n              <div class=\"feature-item anim-in\" style=\"\"><div class=\"feature-num\">3</div><div class=\"feature-text\"><strong data-edit=\"tech-3-name\" contenteditable=\"\" spellcheck=\"false\">Reflexion Technology</strong><span data-edit=\"tech-3-desc\" contenteditable=\"\" spellcheck=\"false\"> — Sensor and stray-light technology using reflexion principles.</span></div></div>\n              <div class=\"feature-item anim-in\" style=\"\"><div class=\"feature-num\">4</div><div class=\"feature-text\"><strong data-edit=\"tech-4-name\" contenteditable=\"\" spellcheck=\"false\">Spectrometer</strong><span data-edit=\"tech-4-desc\" contenteditable=\"\" spellcheck=\"false\"> — Polarized filter sensor-technology for spectral analysis.</span></div></div>\n            </div>\n          </div>\n\n          <!-- Panel 3 — Global Network: a single uploadable map image (simplified from the old pin map) -->\n          <div class=\"ls-tab-panel\" data-panel=\"3\">\n            <div class=\"card template02-company-map\" data-edit=\"map-image\" data-edit-type=\"image\" title=\"Click to change the map image\">\n              <img class=\"template02-company-map-img\" src=\"/slides/uploads/World-Map-of-locations-.jpeg\" alt=\"Global network map\" onerror=\"this.classList.add('template02-company-map-img--missing')\">\n              <label class=\"template02-company-map-placeholder\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"3\"></rect>\n                  <circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\"></circle>\n                  <polyline points=\"21 15 16 10 5 21\"></polyline>\n                </svg>\n                <span>Network Map</span>\n                <small>Click to upload</small>\n              </label>\n            </div>\n          </div>\n\n          <!-- Panel 4 — IQC Group: brand cards -->\n          <div class=\"ls-tab-panel\" data-panel=\"4\">\n            <div class=\"template02-company-iqc\">\n              <div class=\"card card-iqc\"><img src=\"/slides/shared/LOGO SoftSolution grays.png\" alt=\"Softsolution\" class=\"card-iqc-logo\"><div class=\"card-iqc-country\">Austria</div><ul class=\"card-iqc-products\"><li>LineScanner</li><li>BowScanner</li><li>CulletScanner</li><li>VirtualDigitizing</li></ul></div>\n              <div class=\"card card-iqc\"><img src=\"/slides/shared/LOGO LiteSentry Greys.png\" alt=\"LiteSentry\" class=\"card-iqc-logo\"><div class=\"card-iqc-country\">United States</div><ul class=\"card-iqc-products\"><li>Osprey® 25 Distortion Inspection</li><li>Osprey® 25 Anisotropy Inspection</li><li>Owl – Furnace Control</li><li>LoadValidator</li><li>TS 4000 Thickness &amp; Coating Sen