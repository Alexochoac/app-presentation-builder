      "col-header-ben": {
        "en": "LineScanner &amp; Osprey",
        "es": {
          "current": "LineScanner y Osprey",
          "previous": "LineScanner y Osprey",
          "dirty": false
        }
      },
      "ben-list": {
        "en": "<li>100% inspection of every glass, every shift — no fatigue, no blind spots</li><li>Real-time process control &amp; quality feedback</li><li>Prove quality to customers — a documented defense against claims</li><li>Database &amp; archive for shift accountability and CpK analysis</li><li>Detects distortion, anisotropy &amp; surface defects <strong>invisible to the human eye</strong></li><li class=\"\">Acceptance procedures for new machinery (e.g. furnaces)</li><li draggable=\"false\" class=\"\">Mandatory as per industry standards</li><li class=\"\">Increase throughput &amp; reduce costly downstream rejects</li><li class=\"\">New item lo que sea&nbsp;</li>",
        "es": {
          "current": "<li>Inspección del 100% de cada vidrio, cada turno — sin fatiga, sin puntos ciegos</li><li>Control de proceso en tiempo real y retroalimentación de calidad</li><li>Demuestre calidad a los clientes — una defensa documentada contra reclamaciones</li><li>Base de datos y archivo para rendición de cuentas por turno y análisis CpK</li><li>Detecta distorsión, anisotropía y defectos superficiales <strong>invisibles al ojo humano</strong></li><li class=\"\">Procedimientos de aceptación para maquinaria nueva (p. ej. hornos)</li><li draggable=\"false\" class=\"\">Obligatorio según estándares de la industria</li><li class=\"\">Aumentar el rendimiento y reducir rechazos costosos aguas abajo</li><li class=\"\">Nuevo elemento lo que sea&nbsp;</li>",
          "previous": "<li>Inspección del 100% de cada vidrio, cada turno — sin fatiga, sin puntos ciegos</li><li>Control de proceso en tiempo real y retroalimentación de calidad</li><li>Demuestre calidad a los clientes — una defensa documentada contra reclamaciones</li><li>Base de datos y archivo para responsabilidad del turno y análisis de CpK</li><li>Detecta distorsión, anisotropía y defectos de superficie <strong>invisibles al ojo humano</strong></li><li class=\"\">Procedimientos de aceptación para maquinaria nueva (p. ej. hornos)</li><li draggable=\"false\" class=\"\">Obligatorio según los estándares de la industria</li><li class=\"\">Aumentar el rendimiento y reducir rechazos costosos aguas abajo</li><li class=\"\" contenteditable=\"true\">Nuevo elemento lo que sea&nbsp;</li>",
          "dirty": false
        }
      },
