# Copy this file to .env and fill in your values
# Never commit .env to git

BUILDER_USER=admin
BUILDER_PASS=your-password-here
SESSION_SECRET=change-this-to-a-long-random-string
OPENROUTER_API_KEY=your-openrouter-api-key-here
# OPENROUTER_MODEL=anthropic/claude-haiku-4-5  # optional, this is the default

# --- Supabase (Phase 2 multi-user migration) ---
# From Supabase → Settings → API. service_role is secret — server-only, never in the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
