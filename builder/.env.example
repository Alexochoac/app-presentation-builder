# Copy this file to .env and fill in your values
# Never commit .env to git

SESSION_SECRET=change-this-to-a-long-random-string
OPENROUTER_API_KEY=your-openrouter-api-key-here
# OPENROUTER_MODEL=anthropic/claude-haiku-4-5  # optional, this is the default

# --- Supabase (Phase 2 multi-user migration) ---
# From Supabase → Settings → API. service_role is secret — server-only, never in the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# Direct Postgres connection string (Supabase → Connect → Session pooler or Direct).
# Used for Postgres-backed login sessions (survive server restarts). Contains the
# DB password — secret. If unset, sessions fall back to in-memory (lost on restart).
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-ref.supabase.co:5432/postgres

# --- Auth (Phase 3) ---
# Login is now Supabase Auth (email + password) — no more BUILDER_USER/BUILDER_PASS.
# ADMIN_EMAILS: who may manage users at /admin/users (comma-separated). If left
# blank, ANY logged-in user can manage users — set this to lock it down.
ADMIN_EMAILS=you@example.com
