# Copy this file to .env and fill in your values
# Never commit .env to git

SESSION_SECRET=change-this-to-a-long-random-string
OPENROUTER_API_KEY=your-openrouter-api-key-here
# OPENROUTER_MODEL=anthropic/claude-haiku-4-5  # optional, this is the default

# --- Supabase (Phase 2 multi-user migration) ---
# From Supabase → Settings → API. service_role is secret — server-only, never in the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# Direct Postgres connection string (Supabase → Connect → Session pooler or Direct).
# Used for Postgres-backed login sessions (survive server restarts). Contains the
# DB password — secret. If unset, sessions fall back to in-memory (lost on restart).
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-ref.supabase.co:5432/postgres

# --- Auth (Phase 3) ---
# Login is now Supabase Auth (email + password) — no more BUILDER_USER/BUILDER_PASS.
# ADMIN_EMAILS: who may manage users at /admin/users (comma-separated). If left
# blank, ANY logged-in user can manage users — set this to lock it down.
ADMIN_EMAILS=you@example.com
#
# ALLOWED_EMAILS: who may sign in via SOCIAL login (Google/LinkedIn), comma-separated.
# Social login is an implicit signup — Supabase creates an account for anyone who
# completes the flow — and every account shares one team until Phase 5 (RLS off).
# So this fails CLOSED: if neither ALLOWED_EMAILS nor ADMIN_EMAILS is set, social
# login is disabled. Defaults to ADMIN_EMAILS when omitted.
# Also turn OFF "Allow new users to sign up" in Supabase → Auth → Sign In / Providers,
# which blocks direct signup against the Supabase API (outside this app's reach).
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# PUBLIC_BASE_URL: the app's canonical external URL. Used for the OAuth redirect_to
# and (when it starts with https://) to enable `trust proxy` + secure cookies.
# Must match an entry in Supabase → Auth → URL Configuration → Redirect URLs.
PUBLIC_BASE_URL=http://localhost:3000
