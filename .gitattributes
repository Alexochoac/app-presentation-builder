# Normalize line endings to LF in the repo to prevent CRLF/LF churn
# (Windows/WSL editors can otherwise rewrite whole files, creating phantom diffs).
* text=auto eol=lf

# Binary assets — never normalize
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg text eol=lf
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
